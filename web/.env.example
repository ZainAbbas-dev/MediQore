# MediQore supervisor and admin portal: environment variables
# Copy to web/.env if you need to change a default. web/.env is git-ignored: never commit it.
# Everything prefixed VITE_ is built into the browser bundle, so never put a secret here.

# Base URL of the REST API. The default /api/v1 works in development because
# `npm run dev` forwards /api to the API (see vite.config.mjs). Set a full URL
# for a build that talks to a separate API host, for example the staging server.
# VITE_API_BASE_URL=https://staging.example.org/api/v1

# Where the development server forwards /api (read by vite.config.mjs).
# API_PROXY_TARGET=http://localhost:3000
