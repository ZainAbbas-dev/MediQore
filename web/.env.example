# MediQore supervisor and admin portal: environment variables
# Copy to web/.env and fill in local values. web/.env is git-ignored: never commit it.
# Everything here is built into the browser bundle, so never put a secret in this file.

# Base URL of the REST API, including the /api/v1 prefix.
# Rename with your build tool's prefix once P0-5 picks it
# (for example VITE_API_BASE_URL for Vite, REACT_APP_API_BASE_URL for Create React App).
API_BASE_URL=http://localhost:3000/api/v1

