# https://editorconfig.org — VS Code needs the "EditorConfig for VS Code" extension.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Python (ml/) follows PEP 8.
[*.py]
indent_size = 4

# Trailing double spaces are line breaks in Markdown.
[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf

[Makefile]
indent_style = tab
