# MediQore REST API: environment variables
# Copy to api/.env and fill in local values. api/.env is git-ignored: never commit it.
# Values below are placeholders, not real credentials.

# --- Server ------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# --- Database (P0-4) ---------------------------------------------------------
# Local PostgreSQL 15 for development (roadmap: Environments). Required.
# Create the schema first: cd ../db && npm run migrate:up
DATABASE_URL=postgres://mediqore:change-me@localhost:5432/mediqore

# Separate, empty database for `npm test`. Its name must end in _test, because
# the tests empty every table. Leave it unset to skip the database tests.
# Create it once, then run the migrations against it from db/ (same URL in db/.env):
#   cd ../db; npm run migrate:test
TEST_DATABASE_URL=postgres://mediqore:change-me@localhost:5432/mediqore_test

# --- Auth (M1 FE-2) ----------------------------------------------------------
# Signs the short-lived access token. Required. Use a long random string and a
# different one for each environment.
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
# Refresh tokens are random and stored hashed, so they need no secret. Days until one expires:
REFRESH_TOKEN_TTL_DAYS=30

# Login rate limiting: failed sign-ins allowed per client address and username in the window.
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15

# One-time activation codes for the first sign-in on a phone (M1 FE-2): hours until one expires.
ACTIVATION_CODE_TTL_HOURS=48
# Optional key for the phones' offline PIN-reset secrets. Unset, it is derived from
# JWT_ACCESS_SECRET; changing either one means every phone must be activated again
# before a supervisor reply code works for it.
# PIN_RESET_SECRET=change-me

# --- HTTPS (M1 FE-2) ------------------------------------------------------------
# Plain HTTP is refused when REQUIRE_HTTPS=true (the default when NODE_ENV=production).
# Behind a reverse proxy that ends TLS, set TRUST_PROXY to the number of proxies (usually 1).
# REQUIRE_HTTPS=false
# TRUST_PROXY=1

# --- Staging (docs/staging.md) ---------------------------------------------------
# The built portal to serve next to /api/v1 on one address, relative to api/.
# Leave unset in development, where `npm run dev` in web/ serves the portal.
# PORTAL_DIR=../web/dist

