# MediQore REST API: environment variables
# Copy to api/.env and fill in local values. api/.env is git-ignored: never commit it.
# Values below are placeholders, not real credentials.

# --- Server ------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# --- Database (P0-4) ---------------------------------------------------------
# Local PostgreSQL 15 for development (roadmap: Environments).
DATABASE_URL=postgres://mediqore:change-me@localhost:5432/mediqore

# --- Auth (M1 FE-2) ----------------------------------------------------------
# Short-lived access token plus a longer refresh token, both revocable on deactivation.
# Use long random strings; generate a different pair for each environment.
# The lifetimes are examples; agree the real values in P0-3.
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Supervisor portal -------------------------------------------------------
# Origin of the React portal (web/) allowed to call this API.
# The port depends on the dev server chosen in P0-5.
CORS_ORIGIN=http://localhost:5173

# --- Added in later tasks (do not fill in yet) -------------------------------
# OTP channel for M1 FE-2: decided in P0-11 (email OTP or admin-issued one-time code).
# Firebase Cloud Messaging for Layer 1 emergency alerts (M5 FE-2, Phase 2):
#   service-account credentials path; keep the JSON file itself out of git.
