# MediQore database scripts: environment variables
# Copy to db/.env and fill in local values. db/.env is git-ignored: never commit it.
# Values below are placeholders, not real credentials.

# Local PostgreSQL 15 database that migrations (and later the seed script) run against.
# Use the same database as api/.env.
DATABASE_URL=postgres://mediqore:change-me@localhost:5432/mediqore
