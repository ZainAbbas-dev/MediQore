# MediQore LHW app: build-time settings
# Flutter does not read .env files at runtime. Pass each value with --dart-define, for example:
#   flutter run --dart-define=API_BASE_URL=http://10.0.2.2:3000/api/v1
# (10.0.2.2 is the host machine as seen from the Android emulator.)
# If you keep a local copy of this file as mobile/.env, it is git-ignored: never commit it.

# Base URL of the REST API used by the sync engine (M3 FE-2), including /api/v1.
API_BASE_URL=http://10.0.2.2:3000/api/v1

