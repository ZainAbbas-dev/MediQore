# MediQore ML pipeline and analytics worker: environment variables
# Copy to ml/.env and fill in local values. ml/.env is git-ignored: never commit it.

# Model training (P0-10, Module 4) needs no secrets: it reads the public UCI
# Maternal Health Risk dataset from disk and writes the ONNX model and SHAP
# lookup for the mobile app.

# Optional: read the UCI CSV from another place instead of ml/data/raw/maternal_health_risk.csv.
# MEDIQORE_UCI_CSV=C:\path\to\maternal_health_risk.csv

